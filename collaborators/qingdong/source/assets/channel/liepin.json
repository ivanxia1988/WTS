{
  "channel_id": "liepin",
  "display_name": "猎聘",
  "interaction_mode": "human",
  "rule_version": "liepin-2026.08.25.1",
  "allowed_domains": [
    "h.liepin.com",
    "passport.liepin.com",
    "www.liepin.com"
  ],
  "urls": {
    "search": "https://h.liepin.com/search/getConditionItem",
    "detail_path_contains": "/resume/showresumedetail/",
    "login_path_contains": ["/account/login", "/login/"],
    "verification_path_contains": ["/two-factor", "/verify", "/security"]
  },
  "page_detection": [
    {
      "id": "verification",
      "status": "human_required",
      "reason": "SECURITY_VERIFICATION_REQUIRED",
      "resume_condition": {
        "all": [
          {"url_not_contains": ["/two-factor", "/verify", "/security"]},
          {
            "none_visible": [
              "input.auth-code-input",
              "input[placeholder*='验证码']",
              "input[placeholder*='校验码']"
            ]
          }
        ]
      },
      "when": {
        "any": [
          {"url_contains": ["/two-factor", "/verify", "/security"]},
          {
            "any_visible": [
              "input.auth-code-input",
              "input[placeholder*='验证码']",
              "input[placeholder*='校验码']"
            ]
          },
          {"text_any": ["安全验证", "请完成验证", "拖动滑块", "访问异常", "操作频繁", "行为验证", "验证后继续"]}
        ]
      }
    },
    {
      "id": "login",
      "status": "login_required",
      "reason": "LOGIN_REQUIRED",
      "resume_condition": {
        "all": [
          {"url_contains": ["/search/getConditionItem", "/resume/showresumedetail/"]},
          {
            "none_visible": [
              "input.phone-item-input",
              "input[placeholder*='手机']",
              "input[autocomplete='tel']"
            ]
          }
        ]
      },
      "when": {
        "any": [
          {"url_contains": ["/account/login", "/login/"]},
          {
            "any_visible": [
              "input.phone-item-input",
              "input[placeholder*='手机']",
              "input[autocomplete='tel']"
            ]
          },
          {"text_any": ["立即登录/注册", "请输入手机号码", "短信验证码登录"]}
        ]
      }
    },
    {
      "id": "search",
      "status": "ready",
      "when": {
        "all": [
          {"url_contains": ["/search/getConditionItem"]},
          {
            "any_visible": [
              ".search-auto-complete-box .auto-input-wrap-v3 input.ant-select-selection-search-input",
              ".search-top-bar .search-area input[placeholder*='职位/公司/行业']",
              ".search-top-bar input.ant-select-selection-search-input:not([readonly])"
            ]
          },
          {"text_any": ["找简历", "目前城市", "期望城市"]}
        ]
      }
    },
    {
      "id": "detail",
      "status": "ready",
      "when": {
        "all": [
          {"url_contains": ["/resume/showresumedetail/"]},
          {"any_visible": ["#resume-detail-single"]},
          {"text_any": ["工作经历", "项目经历", "教育经历", "求职意向"]}
        ]
      }
    }
  ],
  "selectors": {
    "keyword_inputs": [
      ".search-auto-complete-box .auto-input-wrap-v3 input.ant-select-selection-search-input",
      ".search-top-bar .search-area input[placeholder*='职位/公司/行业']",
      ".search-top-bar input.ant-select-selection-search-input:not([readonly])"
    ],
    "search_buttons": [
      ".search-auto-complete-box > button.search-btn",
      ".search-top-bar button.search-btn"
    ],
    "result_roots": ["#resultList.result-list", "#resultList"],
    "candidate_rows": [
      "#resultList table.new-resume-card tbody > tr[data-tlg-elem-id='h_pc_search_res_listcard']",
      "#resultList table.new-resume-card tbody > tr"
    ],
    "candidate_names": [".new-resume-personal-name > em", ".new-resume-personal-name"],
    "next_page": [
      "#resultList .resume-list-pagebar > .ant-pagination-next:not(.ant-pagination-disabled) button",
      "#resultList .resume-list-pagebar > .ant-pagination-next:not(.ant-pagination-disabled)"
    ],
    "active_page": ["#resultList .resume-list-pagebar > .ant-pagination-item-active"],
    "page_items": ["#resultList .resume-list-pagebar > .ant-pagination-item"],
    "loading": [
      "#resume-search-nprogress-loading:not(:empty)",
      "#resume-search-nprogress-loading #nprogress",
      ".ant-spin-spinning",
      ".ant-spin-container.ant-spin-blur",
      "#resultList[aria-busy='true']",
      "#resultList .ant-skeleton"
    ],
    "empty_results": [
      "#resultList .ant-empty",
      "#resultList .no-data",
      "#resultList [class*='empty-result']"
    ],
    "clear_filters": [".search-filter .search-clear"],
    "submitted_filter_chips": [".search-suck-quick-filter .swiper-wrapper label .text-choose"],
    "city_modal": [".ant-modal.city-modal[role='dialog']", ".ant-modal.city-modal"],
    "city_search_inputs": [".ant-modal.city-modal input.ant-input[placeholder='搜索城市']"],
    "city_suggestions": [".ant-modal.city-modal .suggest-list li"],
    "city_selected": [".ant-modal.city-modal .ant-tag.ant-tag-checkable-checked"],
    "city_confirm": [".ant-modal.city-modal .antd-lp-city-data-result .result-btn button.ant-btn-primary"],
    "city_close": [".ant-modal.city-modal .city-modal-close", ".antd-fd-city-modal .ant-modal-close"],
    "select_dropdowns": [".ant-select-dropdown.search-select:not(.ant-select-dropdown-hidden)"],
    "select_options": [".ant-select-item-option:not(.ant-select-item-option-disabled) .ant-select-item-option-content"],
    "age_low": ["#ageLow.age-input", "#ageLow"],
    "age_high": ["#ageHigh.age-input", "#ageHigh"],
    "age_submit": [".search-item.age-box .age-shadow-box button.shadow-box-submit-btn"],
    "detail_root": ["#resume-detail-single"],
    "detail_basic": ["#resume-detail-basic-info"],
    "detail_intention": ["#resume-detail-job-exp-info"],
    "detail_work": ["#resume-detail-work-info"],
    "detail_project": ["#resume-detail-project-info"],
    "detail_education": ["#resume-detail-edu-info"],
    "detail_language": ["#resume-detail-lang-info"],
    "detail_summary": ["#resume-detail-self-eva-info"]
  },
  "filter_order": [
    "current_cities",
    "expected_cities",
    "experience_years",
    "education",
    "school_requirements",
    "age_range",
    "activity_recency",
    "job_hop_frequency"
  ],
  "filters": {
    "current_cities": {
      "interaction": "city_modal",
      "row": {"css": ".search-filter .search-item.sfilter-city", "text": {"contains": "目前城市"}},
      "trigger": {"css": ".btn-choose"}
    },
    "expected_cities": {
      "interaction": "city_modal",
      "row": {"css": ".search-filter .search-item.sfilter-city", "text": {"contains": "期望城市"}},
      "trigger": {"css": ".btn-choose"}
    },
    "experience_years": {
      "interaction": "inline_option",
      "row": {"css": ".search-filter .search-item.sfilter-work-year", "text": {"contains": "工作年限"}},
      "option": {"any_css": [".tag-item", ".unlimited-btn"]}
    },
    "education": {
      "interaction": "inline_option",
      "row": {"css": ".search-filter .search-item.sfilter-edu", "text": {"contains": "教育经历"}},
      "option": {"any_css": [".tag-item", ".unlimited-btn"]}
    },
    "school_requirements": {
      "interaction": "inline_option",
      "row": {"css": ".search-filter .search-item.sfilter-additional", "text": {"contains": "院校要求"}},
      "option": {"any_css": [".tag-item", ".unlimited-btn"]}
    },
    "age_range": {
      "interaction": "range_inputs",
      "row": {"css": ".search-filter .sfilter-other-condition .search-item.age-box", "text": {"contains": "年龄"}}
    },
    "activity_recency": {
      "interaction": "select_dropdown",
      "row": {"css": ".search-filter .sfilter-other-condition .search-item", "text": {"contains": "活跃度"}},
      "trigger": {"css": ".ant-select-selector"}
    },
    "job_hop_frequency": {
      "interaction": "select_dropdown",
      "row": {
        "css": ".search-filter .sfilter-other-condition .search-item.line-wrap",
        "text": {"contains_any": ["跳槽频率", "近5年不超过3段", "近3年不超过2段", "近2段均不低于2年"]}
      },
      "trigger": {"css": ".ant-select-selector"}
    }
  },
  "canonical_values": {
    "cities": {
      "cn.beijing": "北京",
      "cn.shanghai": "上海",
      "cn.guangzhou": "广州",
      "cn.shenzhen": "深圳",
      "cn.hangzhou": "杭州",
      "cn.suzhou": "苏州",
      "cn.chengdu": "成都",
      "cn.wuhan": "武汉",
      "cn.nanjing": "南京",
      "cn.xian": "西安",
      "cn.tianjin": "天津",
      "cn.fujian": "福建"
    },
    "education": {
      "bachelor": "本科",
      "master": "硕士",
      "doctor": "博士/博士后",
      "college": "大专",
      "secondary": "中专/中技",
      "high_school_or_below": "高中及以下"
    },
    "school_requirements": {
      "211": "211",
      "985": "985",
      "double_first_class": "双一流",
      "overseas": "海外留学"
    },
    "activity_recency": {
      "today": "今天活跃",
      "within_3_days": "3天内活跃",
      "within_7_days": "7天内活跃",
      "within_30_days": "30天内活跃",
      "within_3_months": "最近三个月活跃",
      "within_6_months": "最近半年活跃",
      "within_1_year": "最近一年活跃"
    },
    "job_hop_frequency": {
      "last_5_years_max_3": "近5年不超过3段",
      "last_3_years_max_2": "近3年不超过2段",
      "recent_2_jobs_min_2_years_each": "近2段均不低于2年"
    }
  },
  "experience_presets": [
    {"min": 0, "max": 0, "label": "应届生"},
    {"min": 1, "max": 3, "label": "1-3年"},
    {"min": 3, "max": 5, "label": "3-5年"},
    {"min": 5, "max": 10, "label": "5-10年"},
    {"min": 10, "max": null, "label": "10年以上"}
  ],
  "text_markers": {
    "no_results": ["暂无符合条件的人选", "暂无搜索结果", "没有找到相关人选", "共0位人选"],
    "blocked_actions": ["立即沟通", "超级聊聊", "查看联系方式", "下载简历", "索要附件"]
  },
  "timing": {
    "stable_window_ms": 800,
    "search_timeout_ms": 18000,
    "detail_timeout_ms": 15000,
    "control_timeout_ms": 5000,
    "poll_interval_ms": 220,
    "minimum_action_delay_ms": 800
  },
  "limits": {
    "max_pages": 5,
    "max_candidates": 200,
    "max_details": 20,
    "max_result_bytes": 1048576,
    "max_highlights": 8,
    "max_highlight_length": 180,
    "max_section_length": 2400
  }
}
